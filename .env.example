# Doyofy / ضيوفي — build-time configuration (names only; never commit real values).
# Both values are PUBLIC by design (they ship in the browser bundle); security comes from RLS + RPCs.
# Leave them empty to keep the browser-local mock (current default). See backend/README.md.
DOYOFY_SUPABASE_URL=
DOYOFY_SUPABASE_ANON_KEY=
# Which sign-in the organizer app offers once auth UI exists: "email" (one-time code) or "phone" (SMS code).
DOYOFY_AUTH_PROVIDER=
# NEVER put the Supabase service-role / sb_secret_ key here or in any DOYOFY_* variable.
# Server-only secrets (WhatsApp provider token, webhook secret, SMTP/SMS credentials) belong in
# Supabase Edge Function secrets or the Supabase dashboard, not in the static site build.
